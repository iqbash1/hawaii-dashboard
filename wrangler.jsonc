{
  "name": "hawaii-dashboard",
  "compatibility_date": "2025-09-27",
  "main": "worker.js",
  // 01:00 and 03:00 HST: start the daily question email workflow (worker-cron.mjs).
  "triggers": { "crons": ["0 11 * * *", "0 13 * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/tour.mp4", "/api/*", "/mcp"]
  }
}
