{
  "name": "hawaii-dashboard",
  "version": "1.0.0",
  "description": "A statewide scorecard of outcomes for Hawaiʻi residents and policymakers.",
  "repository": {
    "type": "git",
    "url": "https://github.com/iqbash1/hawaii-dashboard"
  },
  "homepage": "https://hawaiidashboard.org",
  "license": "SEE LICENSE IN DOCUMENTATION.md",
  "private": true,
  "scripts": {
    "build": "bash build.sh",
    "lint": "eslint js/app.js js/modal.js js/export.js js/routing.js js/compute.js js/charts.js js/bundles.js",
    "lint:fix": "eslint --fix js/app.js js/modal.js js/export.js js/routing.js js/compute.js js/charts.js js/bundles.js",
    "validate": "node scripts/validate-data.js",
    "validate:strict": "node scripts/validate-data.js --strict",
    "validate:fresh": "node scripts/validate-data.js --fresh-fetch",
    "recompute": "node scripts/recompute-data.js",
    "og": "python3 scripts/generate-og-pages.py",
    "serve": "python3 -m http.server 8080",
    "audit-links": "node scripts/audit-links.js",
    "update-years": "node scripts/update-narrative-years.js",
    "update-monthly": "node scripts/update-monthly.js",
    "audit-metric": "node scripts/audit-metric.js"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  }
}
